# Required: the address users open in the browser (https, no trailing path)
PUBLIC_URL=https://habits.example.org

# Optional (defaults shown) – see docs/configuration.md
# DEFAULT_TIMEZONE=UTC
# Accounts only by invitation (default) or open registration
# REGISTRATION=invite
# INVITE_EXPIRY_DAYS=7
# SESSION_IDLE_MINUTES=43200
# SESSION_ABSOLUTE_HOURS=2160
# FORWARDED_ALLOW_IPS=*
# LOG_LEVEL=INFO
# Reminders via Web Push (needs outgoing HTTPS to the push services)
# PUSH_ENABLED=true
# PUSH_CONTACT=mailto:admin@example.org
