 "components": {
  "schemas": {
   "AccountExport-Output": {
    "properties": {
     "format": {
      "type": "string",
      "const": "pomale-export",
      "title": "Format",
      "default": "pomale-export"
     },
     "version": {
      "type": "integer",
      "const": 1,
      "title": "Version",
      "default": 1
     },
     "app_version": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 40
       },
       {
        "type": "null"
       }
      ],
      "title": "App Version"
     },
     "exported_at": {
      "anyOf": [
       {
        "type": "string",
        "format": "date-time"
       },
       {
        "type": "null"
       }
      ],
      "title": "Exported At"
     },
     "account": {
      "$ref": "#/components/schemas/ExportAccount"
     },
     "groups": {
      "items": {
       "$ref": "#/components/schemas/ExportGroup"
      },
      "type": "array",
      "maxItems": 200,
      "title": "Groups"
     },
     "habits": {
      "items": {
       "$ref": "#/components/schemas/ExportHabit-Output"
      },
      "type": "array",
      "maxItems": 1000,
      "title": "Habits"
     },
     "pauses": {
      "items": {
       "$ref": "#/components/schemas/ExportPause"
      },
      "type": "array",
      "maxItems": 2000,
      "title": "Pauses"
     }
    },
    "type": "object",
    "title": "AccountExport"
   },
   "CheckinRead": {
    "properties": {
     "habit_id": {
      "type": "integer",
      "title": "Habit Id"
     },
     "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
     },
     "done": {
      "type": "boolean",
      "title": "Done"
     },
     "state": {
      "type": "string",
      "enum": [
       "not_planned",
       "open",
       "done",
       "extra_done",
       "future",
       "paused",
       "partial"
      ],
      "title": "State",
      "description": "`open`: planned, not done yet; `done`; `partial`: quantity below its target; `extra_done`: done on a day that was not planned (never hurts the quota); `not_planned`; `paused`; `future`: after today"
     },
     "version": {
      "type": "integer",
      "title": "Version",
      "description": "Grows with every change of this day; send it back as `base_version` to detect conflicts"
     },
     "value": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Value"
     }
    },
    "type": "object",
    "required": [
     "habit_id",
     "date",
     "done",
     "state",
     "version",
     "value"
    ],
    "title": "CheckinRead"
   },
   "CheckinUpdate": {
    "properties": {
     "done": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "title": "Done"
     },
     "value": {
      "anyOf": [
       {
        "type": "integer",
        "maximum": 9999.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Value"
     },
     "op_id": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 64
       },
       {
        "type": "null"
       }
      ],
      "title": "Op Id",
      "description": "Unique id of this change; a repeated id is applied only once"
     },
     "base_version": {
      "anyOf": [
       {
        "type": "integer",
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Base Version",
      "description": "The `version` the client saw; if the day changed since, the answer is 409 `checkin.conflict` with the current state in `server`"
     }
    },
    "type": "object",
    "title": "CheckinUpdate",
    "description": "Set the state of a day: `done`, or `value` for quantity goals (never both).\n\n`done` on a quantity goal sets the value to the target (true) or 0 (false)."
   },
   "DayRead": {
    "properties": {
     "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
     },
     "state": {
      "type": "string",
      "enum": [
       "not_planned",
       "open",
       "done",
       "extra_done",
       "future",
       "paused",
       "partial"
      ],
      "title": "State",
      "description": "`open`: planned, not done yet; `done`; `partial`: quantity below its target; `extra_done`: done on a day that was not planned (never hurts the quota); `not_planned`; `paused`; `future`: after today"
     },
     "planned": {
      "type": "boolean",
      "title": "Planned"
     },
     "done": {
      "type": "boolean",
      "title": "Done",
      "description": "days and weekly goals: checked off; quantity goals: target reached"
     },
     "version": {
      "type": "integer",
      "title": "Version",
      "description": "Grows with every change of this day; send it back as `base_version` to detect conflicts"
     },
     "goal_type": {
      "type": "string",
      "enum": [
       "days",
       "weekly_count",
       "quantity"
      ],
      "title": "Goal Type"
     },
     "target": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Target",
      "description": "quantity: per day; weekly goal: this week's target, reduced for pauses"
     },
     "paused": {
      "type": "boolean",
      "title": "Paused"
     },
     "value": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Value",
      "description": "Amount of a quantity goal; null for other goals"
     },
     "note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "date",
     "state",
     "planned",
     "done",
     "version",
     "goal_type",
     "target",
     "paused",
     "value",
     "note"
    ],
    "title": "DayRead",
    "description": "One day of one habit. goal_type, target, planned, paused, done and value are the raw\ninput of the evaluation (day_service.evaluate), so clients can re-evaluate offline changes."
   },
   "DaysRead": {
    "properties": {
     "today": {
      "type": "string",
      "format": "date",
      "title": "Today",
      "description": "The account's today, with its time zone and day end"
     },
     "timezone": {
      "type": "string",
      "title": "Timezone",
      "description": "IANA time zone of the account"
     },
     "start": {
      "type": "string",
      "format": "date",
      "title": "Start"
     },
     "end": {
      "type": "string",
      "format": "date",
      "title": "End"
     },
     "groups": {
      "items": {
       "$ref": "#/components/schemas/GroupRead"
      },
      "type": "array",
      "title": "Groups"
     },
     "habits": {
      "items": {
       "$ref": "#/components/schemas/HabitDaysRead"
      },
      "type": "array",
      "title": "Habits"
     }
    },
    "type": "object",
    "required": [
     "today",
     "timezone",
     "start",
     "end",
     "groups",
     "habits"
    ],
    "title": "DaysRead"
   },
   "ExportAccount": {
    "properties": {
     "timezone": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 64
       },
       {
        "type": "null"
       }
      ],
      "title": "Timezone"
     },
     "locale": {
      "anyOf": [
       {
        "type": "string",
        "enum": [
         "de",
         "en"
        ]
       },
       {
        "type": "null"
       }
      ],
      "title": "Locale"
     },
     "day_end_hour": {
      "type": "integer",
      "maximum": 6.0,
      "minimum": 0.0,
      "title": "Day End Hour",
      "default": 0
     }
    },
    "type": "object",
    "title": "ExportAccount"
   },
   "ExportCheckin": {
    "properties": {
     "date": {
      "type": "string",
      "format": "date",
      "title": "Date"
     },
